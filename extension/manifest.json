{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.2.7",
  "minimum_chrome_version": "116",
  "description": "__MSG_extensionDescription__",
  "permissions": ["downloads", "storage", "activeTab", "offscreen"],
  "host_permissions": [
    "https://workspace-zb-cdn.qianwen.com/*",
    "https://quark-aistudio-cdn.quark.cn/*",
    "https://*.byteimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://qianwen.com/*",
        "https://www.qianwen.com/*",
        "https://qianwen.my.cn/share/chat/*",
        "https://doubao.com/chat/*",
        "https://www.doubao.com/chat/*",
        "https://doubao.com/thread/*",
        "https://www.doubao.com/thread/*"
      ],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://qianwen.com/*",
        "https://www.qianwen.com/*",
        "https://qianwen.my.cn/share/chat/*",
        "https://doubao.com/chat/*",
        "https://www.doubao.com/chat/*",
        "https://doubao.com/thread/*",
        "https://www.doubao.com/thread/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "default_locale": "en"
}
