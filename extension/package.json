{
  "name": "watermark-remover-extension",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test:browser": "node scripts/smoke.mjs",
    "format": "prettier --write src tests scripts *.json *.html",
    "package": "node scripts/package.mjs",
    "release": "npm run build && npm run package"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "license": "MIT"
}
